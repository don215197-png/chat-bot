# Frontend environment variables (Vite). Copy this file to .env.local and edit.
# Vite exposes variables prefixed with VITE_ to the client at build time.

# Base URL of the Python backend. Leave unset (or set to http://localhost:8000)
# to talk to a local dev backend.
VITE_API_URL=http://localhost:8000

# OPTIONAL: only set if the backend requires a shared secret (BACKEND_API_KEY).
# Matches the value you put in backend/.env. Leave empty for local/personal use.
VITE_BACKEND_API_KEY=
