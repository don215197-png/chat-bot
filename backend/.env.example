# Backend environment variables. Copy this file to .env and edit.
# Loaded by python-dotenv at startup.

# OpenCode API key. hy3-free is a free model and needs NO key — leave empty.
# Only set this if the provider changes to a paid model that requires auth.
# OPENCODE_API_KEY=

# Port the backend listens on (default 8000). Useful behind a reverse proxy.
PORT=8000

# Comma-separated list of extra CORS-allowed origins, for deployed frontends.
# The dev origins (http://localhost:5173, http://127.0.0.1:5173) are always allowed.
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=

# Options below are all documented but required only in specific setups:

# Where SQLite data lives (conversations, messages, users, sessions, sites).
# Defaults to ./chatbot.db (in the backend working directory).
# DATABASE_PATH=./chatbot.db

# Session lifetime in seconds. Default 30 days (2592000). Users must log in again
# once their token expires.
# SESSION_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Rate limiting (per-IP; in-memory per-process - restarting resets all buckets,
# and separate workers share no state). Leave defaults unless you tune traffic.
# ---------------------------------------------------------------------------

# Trust X-Forwarded-For for the client IP. ONLY enable behind a trusted reverse
# proxy that strips/replaces that header, otherwise real users can spoof it.
TRUST_PROXY_HEADERS=false

# Chat: max requests per IP in a sliding window (default 20 per 60s).
CHAT_MAX_REQUESTS=20
CHAT_WINDOW_SECONDS=60

# Publish: max sites per IP in a sliding window (default 5 per 600s).
PUBLISH_MAX_REQUESTS=5
PUBLISH_WINDOW_SECONDS=600

# Publish: flat UTC daily cap per IP (default 50).
PUBLISH_DAILY_LIMIT=50

# Overrun responses carry "Retry-After" (seconds) so clients can wait and retry.
