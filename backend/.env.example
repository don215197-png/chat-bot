# Backend environment variables. Copy this file to .env and edit.
# Loaded by python-dotenv at startup.

# OpenCode API key. hy3-free is a free model and needs NO key — leave empty.
# Only set this if the provider changes to a paid model that requires auth.
# OPENCODE_API_KEY=

# Port the backend listens on (default 8000). Useful behind a reverse proxy.
PORT=8000

# Comma-separated list of extra CORS-allowed origins, for deployed frontends.
# The dev origins (http://localhost:5173, http://127.0.0.1:5173) are always allowed.
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=

# OPTIONAL shared secret. If set, /chat and /chat/stream require:
#   Authorization: Bearer <BACKEND_API_KEY>
# Leave empty for local/personal use.
BACKEND_API_KEY=
